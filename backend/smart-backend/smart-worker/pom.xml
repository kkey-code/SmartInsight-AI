    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.smart.ai</groupId>
        <artifactId>smart-backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>   <!-- 根据实际路径调整 -->
